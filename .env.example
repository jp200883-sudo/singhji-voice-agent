Singh Ji Voice AI — Environment Variables
# Copy to .env and fill in your values

# === Server ===
PORT=8000
HOST=0.0.0.0
DEBUG=false

# === TTS Defaults ===
DEFAULT_TTS_ENGINE=edge
DEFAULT_LANGUAGE=hindi
DEFAULT_VOICE_EDGE=hi-IN-MadhurNeural
DEFAULT_VOICE_KOKORO=af_bella
DEFAULT_VOICE_PIPER=en_US-lessac-medium

# === Audio ===
AUDIO_FORMAT=mp3

# === API Keys (All Optional — TTS is 100% FREE) ===
GROQ_API_KEY=                      # For AI brain features
TELEGRAM_BOT_TOKEN=                # For Telegram bot
HF_TOKEN=                          # HuggingFace token (faster downloads)

# === Cloud Provider ===
RENDER=false
RAILWAY=false
